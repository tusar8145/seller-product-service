# ================= Database (Master) =================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=productdb
DB_USER=productuser
DB_PASS=productpass

# ================= Database (Read Replica) ===========
READ_REPLICA_DB_HOST=localhost
READ_REPLICA_DB_PORT=5432
READ_REPLICA_DB_NAME=productdb
READ_REPLICA_DB_USER=productuser
READ_REPLICA_DB_PASS=productpass

# ================= Kafka =============================
KAFKA_URI=localhost:9092
KAFKA_GROUP_ID=Seller-Services-Group-2
KAFKA_DEFAULT_TOPIC_PARTITION=10

# ================= Redis =============================
REDIS_HOST=localhost
REDIS_PORT=6379

# ================= AWS S3 ============================
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=sl-dev-s3
S3_BUCKET_END_POINT_URI=http://localhost:9000
S3_BUCKET_EXPOSE_URI=http://localhost:9000/sl-dev-s3

# ================= App ===============================
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# ================= Stock worker ======================
STOCK_WORKER_PARALLELISM=8
STOCK_WORKER_QUEUE_CAPACITY=10000
STOCK_WORKER_ENQUEUE_TIMEOUT_MS=2000